# Portal RAG (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── NOVA chat brain (pick ONE) ─────────────────────────────────────────────
# Recommended: OpenRouter → one key for Claude, GPT, Grok, Gemini, etc.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Examples:
# OPENROUTER_MODEL=anthropic/claude-sonnet-4
# OPENROUTER_MODEL=x-ai/grok-4
# OPENROUTER_MODEL=google/gemini-2.5-pro

# Or Grok directly: https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Or Claude directly
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Or any OpenAI-compatible endpoint (Groq, Together, Fireworks, Ollama…)
# NOVA_LLM_API_KEY=
# NOVA_LLM_BASE_URL=https://api.groq.com/openai/v1
# NOVA_LLM_MODEL=llama-3.3-70b-versatile

# Optional force: openrouter | xai | anthropic | openai | compatible
# NOVA_LLM_PROVIDER=openrouter

# Session secret for cookie auth
PORTAL_SESSION_SECRET=change-me-in-production

# Demo login (seeded workspace)
DEMO_EMAIL=demo@portal.local
DEMO_PASSWORD=portal-demo
